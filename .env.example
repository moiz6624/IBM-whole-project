# Copy to a PRIVATE env file and pass it with: docker run --env-file your.env ...
# DO NOT commit the filled-in file.

# IBM API Connect application credentials
IBM_CLIENT_ID=your-ibm-client-id
IBM_CLIENT_SECRET=your-ibm-client-secret

# Flask session signing key (use a long random value)
FLASK_SECRET=change-me-to-a-long-random-string

# Credentials required to access the dashboard (HTTP Basic Auth)
APP_AUTH_USER=apic
APP_AUTH_PASS=change-me

